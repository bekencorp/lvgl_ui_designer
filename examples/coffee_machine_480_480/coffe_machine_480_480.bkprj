                "layout": {
                  "parent": "page_5_obj_5",
                  "zIndex": 0,
                  "isLocked": false,
                  "isVisible": true
                },
                "events": [
                  {
                    "id": "event_1769592540213_hviunziny",
                    "eventType": "LV_EVENT_CLICKED",
                    "actionType": "custom_code",
                    "actionParams": {
                      "customCode": {
                        "c": {
                          "includes": "#include <math.h>      // 用于fmin函数限制索引上限\r\n\r\n// 全局索引变量：对应Python中的global curIndex\r\nint32_t curIndex = 2;  // 初始值可根据业务需求调整\r\n\r\n// 函数原型声明：步骤样式更新核心函数\r\nvoid update_step_styles(void);\r\n\r\nvoid update_step_styles_min(void)\r\n{\r\n    bk_lv_ui_t *bk_ui = &bk_lv_tool_ui;\r\n    // 移除重复定义的bk_ui（全局已定义，避免冗余）\r\n    lv_obj_t *steps[] = {\r\n        bk_ui->customize_bar_1,\r\n        bk_ui->customize_bar_2,\r\n        bk_ui->customize_bar_3,\r\n        bk_ui->customize_bar_4,\r\n        bk_ui->customize_bar_5\r\n    };\r\n    const int32_t step_cnt = sizeof(steps) / sizeof(steps[0]);  // 同步改为int32_t，与索引类型一致\r\n\r\n    // 限制curIndex上限为step_cnt-1，允许0、负数（原逻辑保留）\r\n    curIndex = (int32_t)fmin((float)curIndex, (float)(step_cnt - 1));\r\n\r\n    // 索引自减（触发1次后，curIndex从0→-1，原逻辑保留）\r\n    curIndex--;\r\n\r\n    // 核心修复：idx改为int32_t（有符号），与curIndex类型一致，避免负数比较异常\r\n    for (int32_t idx = 0; idx < step_cnt; idx++)\r\n    {\r\n        // 正确判断：idx <= curIndex（触发1次后curIndex=-1，所有idx>=0均不满足，全为灰色）\r\n        lv_color_t color = (idx <= curIndex) ? lv_color_hex(0x5eadff) : lv_color_hex(0x808080);\r\n        // 设置背景色（补充LVGL样式掩码宏的正确大写：LV_PART_MAIN | LV_STATE_DEFAULT）\r\n        lv_obj_set_style_bg_color(steps[idx], color, LV_PART_MAIN | LV_STATE_DEFAULT);\r\n    }\r\n}",
                          "implementation": "update_step_styles_min();"
                        },
                        "python": {
                          "imports": "",
                          "implementation": "global curIndex  \r\n\r\nsteps = [page_5_obj_14, page_5_obj_15, page_5_obj_16, page_5_obj_17, page_5_obj_18]\r\n\r\ncurIndex = min(curIndex, len(steps)-1)  # 仅限制上限，允许curIndex为0、负数\r\n\r\n# 步骤2：再执行自减操作（此时自减不会被强制拉高）\r\ncurIndex -= 1  \r\n\r\nfor idx, step_obj in enumerate(steps):\r\n    color = lv.color_hex(0x5eadff) if idx <= curIndex else lv.color_hex(0x808080)\r\n    step_obj.set_style_bg_color(color, lv.PART.MAIN | lv.STATE.DEFAULT)"
                        }
                      }
                    },
                    "enabled": true,
                    "createdAt": "2026-01-28T09:29:00.213Z",
                    "updatedAt": "2026-01-29T07:28:16.698Z"
                  }
                ]
              },
