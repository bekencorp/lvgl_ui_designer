                "layout": {
                  "parent": "page_5_obj_5",
                  "zIndex": 0,
                  "isLocked": false,
                  "isVisible": true
                },
                "events": [
                  {
                    "id": "event_1769591531726_g93945vqs",
                    "eventType": "LV_EVENT_CLICKED",
                    "actionType": "custom_code",
                    "actionParams": {
                      "customCode": {
                        "c": {
                          "includes": "void update_step_styles_plus(void);\r\n\r\nvoid update_step_styles_plus(void)\r\n{\r\n    bk_lv_ui_t *bk_ui = &bk_lv_tool_ui;\r\n    // 步骤对象数组：与步进减少函数一致，统一为customize_bar_1~5\r\n    lv_obj_t *steps[] = {\r\n        bk_ui->customize_bar_1,\r\n        bk_ui->customize_bar_2,\r\n        bk_ui->customize_bar_3,\r\n        bk_ui->customize_bar_4,\r\n        bk_ui->customize_bar_5\r\n    };\r\n    const int32_t step_cnt = sizeof(steps) / sizeof(steps[0]);  // 自动计算长度，避免硬编码\r\n\r\n    // 1. 索引自增操作（对应Python：curIndex += 1）\r\n    curIndex += 1;\r\n\r\n    // 2. 限制curIndex在0 ~ step_cnt-1之间（对应Python：curIndex = max(0, min(curIndex, len(steps)-1))）\r\n    // 先限制上限，再限制下限，与Python逻辑完全一致\r\n    curIndex = (int32_t)fmin((float)curIndex, (float)(step_cnt - 1));  // min(curIndex, 4)\r\n    curIndex = (int32_t)fmax((float)curIndex, 0.0f);                   // max(结果, 0)\r\n\r\n    // 3. 遍历步骤对象更新背景色：idx为int32_t，避免负数比较异常（与步进减少函数一致）\r\n    for (int32_t idx = 0; idx < step_cnt; idx++)\r\n    {\r\n        // 选中判断：idx <= curIndex 显示蓝色(0x5eadff)，否则灰色(0x808080)\r\n        lv_color_t color = (idx <= curIndex) ? lv_color_hex(0x5eadff) : lv_color_hex(0x808080);\r\n        // LVGL设置背景色，样式掩码与原有代码保持一致\r\n        lv_obj_set_style_bg_color(steps[idx], color, LV_PART_MAIN | LV_STATE_DEFAULT);\r\n    }\r\n}\r\n",
                          "implementation": "update_step_styles_plus();"
                        },
                        "python": {
                          "imports": "curIndex = 2",
                          "implementation": "global curIndex  \r\n\r\ncurIndex += 1\r\n\r\nsteps = [page_5_obj_14, page_5_obj_15, page_5_obj_16, page_5_obj_17, page_5_obj_18]\r\n\r\n# 限制curIndex在0到列表长度-1之间\r\ncurIndex = max(0, min(curIndex, len(steps)-1))\r\n\r\nfor idx, step_obj in enumerate(steps):\r\n    color = lv.color_hex(0x5eadff) if idx <= curIndex else lv.color_hex(0x808080)\r\n    step_obj.set_style_bg_color(color, lv.PART.MAIN | lv.STATE.DEFAULT)"
                        }
                      }
                    },
                    "enabled": true,
                    "createdAt": "2026-01-28T09:12:11.726Z",
                    "updatedAt": "2026-01-29T07:29:29.080Z"
                  }
                ]
              },
