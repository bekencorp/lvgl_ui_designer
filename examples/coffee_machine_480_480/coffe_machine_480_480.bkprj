                                  "imports": "",
                                  "implementation": "selected_idx = page_2_dropdown_1.get_selected()\r\nif selected_idx == 0:\r\n    set_locale(\"en\", False)\r\nelif selected_idx == 1:\r\n    set_locale(\"zh_CN\", False)\r\nelse:\r\n    set_locale(\"en\", False)"
                                }
                              }
                            },
