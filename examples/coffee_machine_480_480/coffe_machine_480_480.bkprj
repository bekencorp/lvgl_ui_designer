                            "actionParams": {
                              "customCode": {
                                "c": {
                                  "includes": "",
                                  "implementation": "// 核心逻辑：获取值→格式化→设置标签\r\nint slider_val = lv_slider_get_value(bk_ui->settings_slider_1);\r\nchar slider_text_buf[16];\r\nlv_snprintf(slider_text_buf, sizeof(slider_text_buf), \"%d%%\", slider_val);\r\nlv_label_set_text(bk_ui->settings_label_7, slider_text_buf);"
                                },
                                "python": {
                                  "imports": "",
                                  "implementation": "# 1. 获取滑块当前数值（LVGL滑块value为整数类型）\r\nslider_val = page_2_slider_1.get_value()\r\n# 2. 拼接为\"value%\"格式，设置给标签的文本\r\npage_2_label_7.set_text(f\"{slider_val}%\")"
                                }
                              }
                            },
                            "enabled": true,
                            "createdAt": "2026-01-28T10:08:56.656Z",
                            "updatedAt": "2026-01-29T05:42:22.588Z"
                          }
                        ]
