              "customCode": {
                "c": {
                  "includes": "#include <stdint.h>        // 基础类型定义（int32_t/uint32_t）\r\n#include <stdlib.h>        // C标准库头文件（malloc/free，解决核心报错）\r\n\r\n// 全局索引：默认选中第二个对象（对应Python初始值1）\r\nint32_t global_index = 1;\r\n\r\n// 颜色常量：统一管理，与Python完全一致\r\n#define COLOR_SELECTED_BG     lv_color_hex(0x5EADFF)    // 选中对象背景色\r\n#define COLOR_UNSELECTED_BG   lv_color_hex(0x000000)    // 未选中对象背景色\r\n#define COLOR_SELECTED_TEXT   lv_color_hex(0x000000)    // 选中文字色\r\n#define COLOR_UNSELECTED_TEXT lv_color_hex(0x8E8E93)    // 未选中文字色\r\n\r\n// 函数原型声明\r\nvoid update_obj_styles(void);                          // 样式更新核心函数\r\nvoid on_obj_clicked(lv_event_t *e);                    // 点击事件回调函数\r\nvoid obj_label_clickable_init(void);                   // 初始化：注册事件+默认样式\r\n\r\n/************************************\r\n * 实现部分（仅替换lv_mem_alloc为malloc，其余逻辑不变）\r\n ************************************/\r\n// 定义对象-Label映射结构体：存储对象、标签、对应索引\r\ntypedef struct {\r\n    lv_obj_t *obj;       // 目标对象\r\n    lv_obj_t *label;     // 关联标签\r\n    int32_t idx;         // 对应索引（0/1/2）\r\n} ObjLabelMap_t;\r\n\r\n/**\r\n * @brief 样式更新核心函数：根据global_index刷新所有对象/标签的选中/未选中样式\r\n */\r\nvoid update_obj_styles(void)\r\n{\r\n    bk_lv_ui_t *bk_ui = &bk_lv_tool_ui;\r\n    // 定义对象-Label映射关系（组件名已改为customize_xxx）\r\n    ObjLabelMap_t obj_label_mapping[] = {\r\n        {bk_ui->customize_obj_10,  bk_ui->customize_label_7,  0},  // index=0\r\n        {bk_ui->customize_obj_11,  bk_ui->customize_label_8,  1},  // index=1（默认选中）\r\n        {bk_ui->customize_obj_12,  bk_ui->customize_label_9,  2}   // index=2\r\n    };\r\n    uint32_t map_cnt = sizeof(obj_label_mapping) / sizeof(ObjLabelMap_t);\r\n\r\n    // 遍历所有映射关系，逐个设置样式\r\n    for (uint32_t i = 0; i < map_cnt; i++)\r\n    {\r\n        lv_obj_t *obj = obj_label_mapping[i].obj;\r\n        lv_obj_t *label = obj_label_mapping[i].label;\r\n        int32_t idx = obj_label_mapping[i].idx;\r\n\r\n        if (idx == global_index)\r\n        {\r\n            // 选中状态：设置选中背景色+文字色\r\n            lv_obj_set_style_bg_color(obj, COLOR_SELECTED_BG, LV_PART_MAIN | LV_STATE_DEFAULT);\r\n            lv_obj_set_style_text_color(label, COLOR_SELECTED_TEXT, LV_PART_MAIN | LV_STATE_DEFAULT);\r\n        }\r\n        else\r\n        {\r\n            // 未选中状态：设置未选中背景色+文字色\r\n            lv_obj_set_style_bg_color(obj, COLOR_UNSELECTED_BG, LV_PART_MAIN | LV_STATE_DEFAULT);\r\n            lv_obj_set_style_text_color(label, COLOR_UNSELECTED_TEXT, LV_PART_MAIN | LV_STATE_DEFAULT);\r\n        }\r\n    }\r\n    // 强制LVGL刷新，确保样式立即生效\r\n    lv_refr_now(NULL);\r\n}\r\n\r\n/**\r\n * @brief 点击事件回调函数：更新全局索引并刷新样式\r\n */\r\nvoid on_obj_clicked(lv_event_t *e)\r\n{\r\n    // 获取传递的目标索引（从用户数据中读取）\r\n    int32_t *target_idx = (int32_t *)lv_event_get_user_data(e);\r\n    if (target_idx == NULL) return;\r\n\r\n    // 更新全局索引为当前点击对象的索引\r\n    global_index = *target_idx;\r\n    // 刷新所有对象样式，自动区分选中/未选中\r\n    update_obj_styles();\r\n}\r\n\r\n/**\r\n * @brief 初始化函数：为所有对象开启点击、注册事件、设置默认样式\r\n * 核心修复：将lv_mem_alloc替换为C标准库malloc（解决编译报错）\r\n */\r\nvoid obj_label_clickable_init(void)\r\n{\r\n    bk_lv_ui_t *bk_ui = &bk_lv_tool_ui;\r\n    // 定义对象-Label映射关系（与update_obj_styles一致）\r\n    ObjLabelMap_t obj_label_mapping[] = {\r\n        {bk_ui->customize_obj_10,  bk_ui->customize_label_7,  0},\r\n        {bk_ui->customize_obj_11,  bk_ui->customize_label_8,  1},\r\n        {bk_ui->customize_obj_12,  bk_ui->customize_label_9,  2}\r\n    };\r\n    uint32_t map_cnt = sizeof(obj_label_mapping) / sizeof(ObjLabelMap_t);\r\n\r\n    // 遍历为每个对象配置点击属性+注册事件\r\n    for (uint32_t i = 0; i < map_cnt; i++)\r\n    {\r\n        lv_obj_t *obj = obj_label_mapping[i].obj;\r\n        // 核心修复：替换lv_mem_alloc为malloc（C标准库，无需额外头文件）\r\n        int32_t *target_idx = (int32_t *)malloc(sizeof(int32_t)); // 动态分配内存存索引\r\n        if (target_idx == NULL) continue;\r\n\r\n        *target_idx = obj_label_mapping[i].idx; // 赋值当前索引\r\n        lv_obj_add_flag(obj, LV_OBJ_FLAG_CLICKABLE); // 开启点击可响应\r\n        // 注册点击事件：绑定回调+传递索引作为用户数据\r\n        lv_obj_add_event_cb(obj, on_obj_clicked, LV_EVENT_CLICKED, target_idx);\r\n    }\r\n\r\n    // 初始化样式：程序启动时刷新，确保默认选中index=1的对象\r\n    update_obj_styles();\r\n}",
                  "implementation": " obj_label_clickable_init();"
                },
                "python": {
                  "imports": "# 1. 定义全局index，初始值设置为2（默认选中第三个obj）\r\nglobal_index = 1\r\n\r\n# 2. 定义选中/未选中的颜色常量（统一管理，便于修改）\r\nCOLOR_SELECTED_BG = lv.color_hex(0x5EADFF)    # 选中obj背景色\r\nCOLOR_UNSELECTED_BG = lv.color_hex(0x000000)  # 未选中obj背景色\r\nCOLOR_SELECTED_TEXT = lv.color_hex(0x000000)  # 选中Label文字色\r\nCOLOR_UNSELECTED_TEXT = lv.color_hex(0x8E8E93)# 未选中Label文字色\r\n",
                  "implementation": "\r\n# 3. 存储obj和对应Label的映射关系（索引0/1/2对应三个对象组，便于遍历）\r\nobj_label_mapping = [\r\n    (page_5_obj_10, page_5_label_7),   # index=0 对应对象\r\n    (page_5_obj_11, page_5_label_8),   # index=1 对应对象\r\n    (page_5_obj_12, page_5_label_9)    # index=2 对应对象（默认选中）\r\n]\r\n\r\n# 4. 样式更新核心函数：根据全局index刷新所有对象的选中/未选中样式\r\ndef update_obj_styles():\r\n    global global_index\r\n    # 遍历所有obj-Label组合，逐个设置样式\r\n    for idx, (obj, label) in enumerate(obj_label_mapping):\r\n        if idx == global_index:\r\n            # 选中状态：设置对应背景色和文字色\r\n            obj.set_style_bg_color(COLOR_SELECTED_BG, lv.PART.MAIN | lv.STATE.DEFAULT)\r\n            label.set_style_text_color(COLOR_SELECTED_TEXT, lv.PART.MAIN | lv.STATE.DEFAULT)\r\n        else:\r\n            # 未选中状态：设置对应背景色和文字色\r\n            obj.set_style_bg_color(COLOR_UNSELECTED_BG, lv.PART.MAIN | lv.STATE.DEFAULT)\r\n            label.set_style_text_color(COLOR_UNSELECTED_TEXT, lv.PART.MAIN | lv.STATE.DEFAULT)\r\n\r\n# 5. 点击事件回调函数：点击obj时更新全局index并刷新样式\r\n# event_obj：被点击的obj对象；target_idx：该obj对应的索引值（0/1/2）\r\ndef on_obj_clicked(event, target_idx):\r\n    global global_index\r\n    # 更新全局index为当前点击的obj索引\r\n    global_index = target_idx\r\n    # 刷新所有对象的样式（自动区分选中/未选中）\r\n    update_obj_styles()\r\n\r\n# 6. 为每个obj注册点击事件，并绑定对应的索引\r\nfor idx, (obj, _) in enumerate(obj_label_mapping):\r\n    # 开启obj的点击可响应状态（LVGL默认部分对象需手动开启）\r\n    obj.add_flag(lv.obj.FLAG.CLICKABLE)\r\n    # 注册点击事件：LVGL_EVENT.CLICKED 为标准点击事件\r\n    # lambda传递当前索引idx，避免循环中索引覆盖\r\n    obj.add_event_cb(lambda e, idx=idx: on_obj_clicked(e, idx), lv.EVENT.CLICKED, None)\r\n\r\n# 7. 初始化样式：程序启动时立即刷新，确保默认选中index=2的对象\r\nupdate_obj_styles()"
                }
              }
            },
            "enabled": true,
            "createdAt": "2026-01-29T02:35:33.478Z",
            "updatedAt": "2026-01-29T07:38:22.930Z"
          }
        ],
