                              "customCode": {
                                "c": {
                                  "includes": "",
                                  "implementation": "uint32_t selected_idx = lv_dropdown_get_selected(bk_ui->settings_dropdown_1);\r\nif(selected_idx == 0) {\r\n    switch_locale(\"en\", true);\r\n}\r\nelse if(selected_idx == 1) {\r\n    switch_locale(\"zh_CN\", true);\r\n}\r\nelse {\r\n    switch_locale(\"en\", true);\r\n}"
                                },
