                        "eventType": "LV_EVENT_CLICKED",
                        "actionType": "custom_code",
                        "actionParams": {
                          "customCode": {
                            "c": {
                              "includes": "",
                              "implementation": "const char *curr_text = lv_label_get_text(bk_ui->settings_label_13);  // 获取标签当前文本\r\nif(lv_strcmp(curr_text, \"oz\") == 0) {                        // 判断是否为\"oz\"\r\n    lv_label_set_text(bk_ui->settings_label_13, \"ml\");                // 是则切换为\"ml\"\r\n} else {\r\n    lv_label_set_text(bk_ui->settings_label_13, \"oz\");                // 否则切换为\"oz\"\r\n}"
                            },
                            "python": {
                              "imports": "",
                              "implementation": "page_2_label_13.set_text(\"ml\" if page_2_label_13.get_text() == \"oz\" else \"oz\")"
                            }
                          }
                        },
                        "enabled": true,
                        "createdAt": "2026-01-28T10:02:16.319Z",
                        "updatedAt": "2026-01-29T03:33:16.831Z"
                      }
                    ]
