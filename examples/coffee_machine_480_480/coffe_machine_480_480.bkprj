                    "events": [
                      {
                        "id": "event_1769594678758_w083j2sty",
                        "eventType": "LV_EVENT_CLICKED",
                        "actionType": "custom_code",
                        "actionParams": {
                          "customCode": {
                            "c": {
                              "includes": "",
                              "implementation": "// 温度单位（°C/°F）互斥切换核心逻辑（与原Python三元表达式功能等价）\r\nconst char *curr_text = lv_label_get_text(bk_ui->settings_label_15);  // 获取标签当前文本\r\nif(lv_strcmp(curr_text, \"°F\") == 0) {                        // 判断是否为\"°F\"\r\n    lv_label_set_text(bk_ui->settings_label_15, \"°C\");                // 是则切换为\"°C\"\r\n} else {\r\n    lv_label_set_text(bk_ui->settings_label_15, \"°F\");                // 否则切换为\"°F\"\r\n}"
                            },
                            "python": {
                              "imports": "",
                              "implementation": "page_2_label_15.set_text(\"°C\" if page_2_label_15.get_text() == \"°F\" else \"°F\")"
                            }
                          }
                        },
                        "enabled": true,
                        "createdAt": "2026-01-28T10:04:38.758Z",
                        "updatedAt": "2026-01-29T03:36:16.762Z"
                      }
                    ]
                  }
                ],
                "layout": {
                  "parent": "page_2_obj_3",
                  "zIndex": 0,
                  "isLocked": false,
                  "isVisible": true
                },
