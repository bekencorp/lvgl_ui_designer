        "events": [
          {
            "id": "event_1769654546479_tzc45kpm8",
            "eventType": "LV_EVENT_SCREEN_LOADED",
            "actionType": "custom_code",
            "actionParams": {
              "customCode": {
                "c": {
                  "includes": "#include <stdint.h>    // 基础类型定义\r\n// 全局定时器句柄：用于管理进度条定时器（便于后续操作）\r\nlv_timer_t *making_bar_timer = NULL;\r\n\r\n// 函数原型声明\r\nvoid making_bar_increase_timer_cb(lv_timer_t *timer);  // 进度条定时器回调\r\nvoid making_bar_timer_init(void);                      // 进度条定时器初始化（含初始值设置+定时器创建）\r\n\r\nvoid making_bar_increase_timer_cb(lv_timer_t *timer)\r\n{\r\n\r\n    bk_lv_ui_t *bk_ui = &bk_lv_tool_ui;\r\n\r\n    if (timer == NULL) return;  // 防空判断，避免野指针\r\n\r\n    // 1. 获取当前进度条值（对应Python：current_val = making_bar_1.get_value()）\r\n    int32_t current_val = lv_bar_get_value(bk_ui->making_bar_1);\r\n    // 2. 步长+1（每次定时器执行，值递增1）\r\n    int32_t new_val = current_val + 1;\r\n\r\n    // 3. 设置进度条新值：无动画（第二个参数0，与Python一致）\r\n    lv_bar_set_value(bk_ui->making_bar_1, new_val, 0);\r\n\r\n    // 4. 更新百分比标签：格式化\"new_val%\"字符串（对应Python：f\"{new_val}%\"）\r\n    char text_buf[8];  // 足够存储\"100%\" + 结束符，避免内存浪费\r\n    lv_snprintf(text_buf, sizeof(text_buf), \"%d%%\", new_val);\r\n    lv_label_set_text(bk_ui->making_label_7, text_buf);\r\n\r\n    // 5. 终止条件：值达到100时，销毁定时器+跳转到page_1（对应Python逻辑）\r\n    if (new_val >= 100)\r\n    {\r\n        lv_timer_del(timer);  // 删除定时器，避免无限执行（LVGL原生API，关键）\r\n        making_bar_timer = NULL;     // 清空全局定时器句柄，避免野指针\r\n\r\n        // 页面跳转：无动画切换到page_1（与Python lv.screen_load_anim 完全一致）\r\n        // 参数：目标页面、动画类型、动画时长(ms)、延迟(ms)、是否自动删除原页面\r\n        lv_screen_load_anim(bk_ui->home, LV_SCR_LOAD_ANIM_NONE, 200, 0, false);\r\n    }\r\n}\r\n\r\n/**\r\n * @brief 进度条定时器初始化函数：设置进度条初始值+创建定时器\r\n * 整合Python 初始化进度条+创建定时器逻辑，统一入口调用\r\n */\r\nvoid making_bar_timer_init(void)\r\n{\r\n    bk_lv_ui_t *bk_ui = &bk_lv_tool_ui;\r\n    // 1. 初始化进度条为0，无动画（确保起始值正确，与Python一致）\r\n    lv_bar_set_value(bk_ui->making_bar_1, 0, 0);\r\n    // 清空百分比标签初始值（可选，避免残留）\r\n    lv_label_set_text(bk_ui->making_label_7, \"0%\");\r\n\r\n    // 2. 销毁原有定时器（避免重复创建，防止进度条加速）\r\n    if (making_bar_timer != NULL)\r\n    {\r\n        lv_timer_del(making_bar_timer);\r\n        making_bar_timer = NULL;\r\n    }\r\n\r\n    // 3. 创建LVGL定时器：100毫秒执行一次，绑定回调函数（与Python完全一致）\r\n    // 参数：回调函数、定时周期(ms)、用户数据(None→NULL)\r\n    making_bar_timer = lv_timer_create(making_bar_increase_timer_cb, 100, NULL);\r\n}",
                  "implementation": "making_bar_timer_init();"
                },
                "python": {
                  "imports": "bar_timer = None",
                  "implementation": "global bar_timer\r\n# 定义定时器回调函数：负责更新进度条值+判断停止条件\r\ndef bar_increase_timer_cb(timer):\r\n    # 获取当前进度条值\r\n    current_val = page_6_bar_1.get_value()\r\n    # 步长+1（每次定时器执行，值递增1）\r\n    new_val = current_val + 1\r\n    # 设置新值：第二个参数0表示无动画（如需动画可改为1，LVGL自动补间）\r\n    page_6_bar_1.set_value(new_val, 0)\r\n    page_6_label_7.set_text(f\"{new_val}%\")\r\n    \r\n    # 终止条件：值达到100时，删除定时器（关键，避免无限执行）\r\n    if new_val >= 100:\r\n        timer.delete()\r\n        global bar_timer\r\n        bar_timer = None  # 销毁后清空全局变量，保持规范\r\n        lv.screen_load_anim(page_1, lv.SCR_LOAD_ANIM.NONE, 200, 0, False)\r\n\r\n\r\n# 初始化进度条为0（确保起始值正确）\r\npage_6_bar_1.set_value(0, 0)\r\n\r\n# 创建LVGL定时器：100毫秒执行一次，绑定回调函数\r\n# 入参：回调函数、定时周期(ms)、定时器参数(None表示无参)\r\nbar_timer = lv.timer_create(bar_increase_timer_cb, 100, None)"
                }
              }
            },
            "enabled": true,
            "createdAt": "2026-01-29T02:42:26.479Z",
            "updatedAt": "2026-01-29T08:18:27.888Z"
          }
        ],
        "createdAt": "2026-01-28T06:17:43.548Z",
        "updatedAt": "2026-02-04T03:32:19.435Z",
        "isStartPage": false
      }
    ],
    "componentLibraries": []
  },
